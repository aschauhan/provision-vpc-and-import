  Publicsubnet1AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PublicNACL
      SubnetId: !Ref PublicSubnet1
  Publicsubnet2AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PublicNACL
      SubnetId: !Ref PublicSubnet2
  Publicsubnet3AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PublicNACL
      SubnetId: !Ref PublicSubnet3

  PrivateNatsubnet1AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref PvtNatSubnet1     
  PrivateNatsubnet2AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref PvtNatSubnet2
  PrivateNatsubnet3AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref PvtNatSubnet3

  AppNrsubnet1AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref AppNrSubnet1
  AppNrsubnet2AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref AppNrSubnet2
  AppNrsubnet3AclAssociation:
    Type: AWS::EC2::SubnetNetworkAclAssociation
    Properties: 
      NetworkAclId: !Ref PrivateNACL
      SubnetId: !Ref AppNrSubnet3

Outputs:
  VPC:
    Description: A reference to the created VPC
    Value: !Ref VPC
  StacksRegion:
    Description: Region VPC is in
    Value: !Ref AWS::Region
  VPCsACL:
    Description: VPC's Network ACL ID
    Value: !GetAtt VPC.DefaultNetworkAcl
  VPCsSecurityGroup:
    Description: VPC Default Security Group ID
    Value: !GetAtt VPC.DefaultSecurityGroup
  PublicSubnets:
    Description: A list of the public subnets
    Value: !Join
      - ''
      - - !Ref PublicSubnet1
        - !Ref PublicSubnet2
        - !Ref PublicSubnet3
  AppSubnets:
    Description: A list of the App subnets
    Value: !Join
      - ''
      - - !Ref AppNrSubnet1
        - !Ref AppNrSubnet2
        - !Ref AppNrSubnet3
  PrivateNatSubnets:
    Description: A list of the Private Nat subnets
    Value: !Join
      - ''
      - - !Ref PvtNatSubnet1
        - !Ref PvtNatSubnet2
        - !Ref PvtNatSubnet3
  PublicSubnet1:
    Description: A reference to the public subnet in the 1st Availability Zone
    Value: !Ref PublicSubnet1
  PublicSubnet2:
    Description: A reference to the public subnet in the 2nd Availability Zone
    Value: !Ref PublicSubnet2
  PublicSubnet3:
    Description: A reference to the public subnet in the 3rd Availability Zone
    Value: !Ref PublicSubnet3
  PrivateNatSubnet1:
    Description: A reference to the private NAT subnet in the 1st Availability Zone
    Value: !Ref PvtNatSubnet1
  PrivateNatSubnet2:
    Description: A reference to the private NAT subnet in the 2nd Availability Zone
    Value: !Ref PvtNatSubnet2
  PrivateNatSubnet3:
    Description: A reference to the private NAT subnet in the 3rd Availability Zone
    Value: !Ref PvtNatSubnet3
  AppNrSubnet1:
    Description: A reference to the Application subnet in the 1st Availability Zone
    Value: !Ref AppNrSubnet1
  AppNrSubnet2:
    Description: A reference to the Application subnet in the 2nd Availability Zone
    Value: !Ref AppNrSubnet2
  AppNrSubnet3:
    Description: A reference to the Application subnet in the 3rd Availability Zone
    Value: !Ref AppNrSubnet3
  PublicRouteTable:
    Description: A reference to the Public Route table 
    Value: !Ref PublicRouteTable
  PvtNatRouteTable1:
    Description: A reference to the Private NAT Route table for 1st Availability Zone
    Value: !Ref PvtNatRouteTable1
  PvtNatRouteTable2:
    Description: A reference to the Private NAT Route table for 2nd Availability Zone
    Value: !Ref PvtNatRouteTable2
  PvtNatRouteTable3:
    Description: A reference to the Private NAT Route table for 3rd Availability Zone
    Value: !Ref PvtNatRouteTable3
  NoIngressSecurityGroup:
    Description: Security group with no ingress rule
    Value: !Ref NoIngressSecurityGroup
